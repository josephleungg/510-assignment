# Copy this file to ".env" and fill it in. ".env" is git-ignored.
# Anything left blank is asked for when the program starts (the password is hidden).
DB_USER=
DB_PASSWORD=
# host:port/service_name   e.g. localhost:1521/FREEPDB1   or the school server's host and service name
DB_DSN=
# Only for very old Oracle servers that need "thick" mode (path to Oracle Instant Client):
# ORACLE_CLIENT_LIB=/path/to/instantclient

# Every SQL statement the program runs is printed in the terminal. Set to 0 to turn that off.
# SHOW_SQL=1
